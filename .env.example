# ---------------------------------------------------------------------------
# OpsFlow — environment configuration example
#
# The standalone demo needs NO environment variables. Everything is seeded into
# the browser. The variables below describe what a production deployment would
# require, and every external integration is optional and off by default.
#
# NEVER commit real values. Vite only exposes variables prefixed with VITE_ to
# the browser bundle, so secrets that must stay private belong on the server.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
VITE_APP_NAME="OpsFlow"
VITE_APP_ENV="demo"                     # demo | staging | production
VITE_DEMO_MODE="true"                   # false disables seeding and requires a backend

# --- Data layer (future backend) -------------------------------------------
# Public anon key only — row-level security must do the authorization work.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only (edge functions / API routes; never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL="postgresql://user:password@host:5432/opsflow"

# --- Automation engine (future worker) -------------------------------------
AUTOMATION_WORKER_URL=""
AUTOMATION_CRON_SECRET=""
AUTOMATION_RETRY_LIMIT="3"

# --- Integration centre ----------------------------------------------------
# Google Sheets / Forms
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Microsoft Excel / Teams (Microsoft 365 app registration)
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
TEAMS_WEBHOOK_URL=""

# Slack
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_BOT_TOKEN=""
SLACK_ALERTS_CHANNEL="#opsflow-alerts"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email / SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="opsflow@example.com"

# --- Observability ---------------------------------------------------------
VITE_SENTRY_DSN=""
